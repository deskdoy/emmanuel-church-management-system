# Phase 6 accepts only a disposable local, preview, or staging Supabase project.
# Never copy the production project reference or a production service-role key here.
PHASE6_SUPABASE_URL=https://YOUR_NON_PRODUCTION_PROJECT_REF.supabase.co
PHASE6_SUPABASE_ANON_KEY=
PHASE6_SUPABASE_SERVICE_ROLE_KEY=
PHASE6_EXPECTED_PROJECT_REF=YOUR_NON_PRODUCTION_PROJECT_REF
PHASE6_CONFIRM=PHASE6_ISOLATED_TEST_ONLY

# Browser tests use these server-side values to start Vite with public credentials.
PHASE6_APP_URL=http://127.0.0.1:4176
