{
  "name": "emmanuel-cash-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern dist",
    "test": "node --test tests/*.test.mjs",
    "phase6:provision": "node --env-file-if-exists=.env.phase6.local scripts/phase6/provision.mjs",
    "phase6:isolation": "node --env-file-if-exists=.env.phase6.local scripts/phase6/run-isolation-tests.mjs",
    "phase6:e2e": "node --env-file-if-exists=.env.phase6.local node_modules/@playwright/test/cli.js test --config=playwright.phase6.config.ts",
    "phase6:cleanup": "node --env-file-if-exists=.env.phase6.local scripts/phase6/cleanup.mjs",
    "phase6:verify": "node --env-file-if-exists=.env.phase6.local scripts/phase6/verify-cleanup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2"
  }
}
